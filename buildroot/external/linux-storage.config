# DrDrOS kernel config fragment — block storage + filesystems.
#
# Why this exists
# ───────────────
# linux-fb.config gives us a screen, linux-input.config gives us input.
# This file gives us **persistence on real hardware** — the thing that
# turns "I wrote a note and it vanished on reboot" into "my files are
# still here". DrDrStore (drdr-store) discovers, mounts and writes to a
# real partition, but the kernel has to (a) enumerate the disk as a block
# device and (b) understand the filesystem on it. The stock x86_64
# defconfig is thin on both for the media DrDrOS actually meets:
#
#   - the USB stick we boot from (Ventoy / dd'd image) — needs the USB
#     mass-storage + SCSI-disk path, which the base defconfig does NOT
#     build in. Without USB_STORAGE + BLK_DEV_SD a USB stick never even
#     appears as /dev/sda, so there is nothing to mount.
#   - the Surface Go 2 microSD slot — needs the SDHCI/MMC block stack.
#   - internal NVMe (ThinkPad T14) — needs the NVMe driver.
#   - the filesystems on all of the above: ext4 (Linux), vfat (every
#     USB stick / EFI System Partition), exfat (large SD cards / sticks),
#     ntfs3 (a Windows data partition, read AND write).
#
# Everything is =y (built in) so it works from the initramfs with no
# module loading — DrDrOS ships no modules.

# ─── SCSI + disk (the umbrella USB storage and SATA both sit on) ──────
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_SCSI_CONSTANTS=y

# ─── SATA / AHCI (internal 2.5" SSDs, some docks) ────────────────────
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y

# ─── USB mass storage (THE path for a boot/data USB stick) ───────────
# UAS is the modern fast variant; usb-storage is the universal fallback.
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ─── NVMe (ThinkPad T14 and most modern laptops' internal disk) ──────
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y

# ─── MMC / SD (Surface Go 2 microSD, many tablets) ───────────────────
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_SDHCI_PLTFM=y

# ─── Partition tables — GPT (modern) + MSDOS (older sticks) ──────────
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# ─── Filesystems DrDrStore mounts ────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
# FAT/VFAT — USB sticks and the EFI System Partition.
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
# exFAT — the default for >32 GB SD cards and many large USB sticks.
CONFIG_EXFAT_FS=y
# NTFS3 — read/write driver for a Windows data partition.
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
# ISO9660 — the booted CD/ISO itself (so we can read our own media).
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
# Optional but cheap: btrfs + xfs so a Linux user's data disk just works.
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y

# ─── Native Language Support (VFAT/exFAT need codepages) ─────────────
# Without the codepage + iso8859-1 + utf8 NLS tables a vfat/exfat mount
# fails with EINVAL even though the driver is present.
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_850=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
