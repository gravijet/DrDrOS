# DrDrOS kernel config fragment — wireless (Wi-Fi) + wired networking.
#
# Why this exists
# ───────────────
# linux-storage.config gave us persistence; this file gives us **the
# network on real hardware**. DrDrNet (peer discovery + chat) and the
# Network panel only have something to talk over if the kernel has a
# driver for the machine's network adapter and the 802.11 stack to drive
# a Wi-Fi radio. The stock x86_64 defconfig builds almost none of this in,
# so on a real laptop/tablet the only interface is loopback.
#
# This enables, all built-in (=y) so they work from the initramfs with no
# module loading (DrDrOS ships no modules):
#
#   - the generic 802.11 stack: cfg80211 + mac80211, the foundation every
#     soft-MAC Wi-Fi driver sits on;
#   - the radios actually found in the target hardware:
#       * Intel iwlwifi (Surface Go 2 = AX200/9000-series, ThinkPad T14 =
#         AX200/AX201) — the single most common Wi-Fi part in this class;
#       * Broadcom brcmfmac (many tablets / SDIO Wi-Fi);
#       * Atheros ath9k/ath10k/ath11k and Realtek rtw88/rtw89 for breadth;
#   - common wired NICs (Intel e1000e/igb, Realtek r8169) so an Ethernet
#     dongle or built-in port comes up too;
#   - USB Wi-Fi/Ethernet dongles (a cheap way to add networking to a
#     machine whose internal radio lacks an in-tree driver).
#
# NOTE — honest status: associating with a *protected* (WPA2/WPA3) network
# additionally needs the wpa_supplicant userspace + the radio's firmware
# blobs in the rootfs; that packaging is tracked on the roadmap. With this
# fragment the radio enumerates (the Network panel lists it) and an OPEN
# network or wired DHCP works; a locked Wi-Fi needs the supplicant step.

# ─── Core networking (ensure the stack + sockets exist) ──────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# ─── 802.11 (Wi-Fi) common stack ─────────────────────────────────────
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y

# ─── Firmware loader (radios pull a blob at probe time) ──────────────
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y

# ─── Intel Wi-Fi (Surface Go 2 / ThinkPad T14 — the priority targets) ─
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y

# ─── Broadcom (tablets, SDIO/USB Wi-Fi) ──────────────────────────────
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMFMAC_PCIE=y

# ─── Atheros ─────────────────────────────────────────────────────────
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_HTC=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_ATH11K=y

# ─── Realtek ─────────────────────────────────────────────────────────
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW89=y

# ─── USB Wi-Fi dongles (broad coverage, common fallback) ─────────────
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=y
CONFIG_MT76x2U=y

# ─── Wired NICs (Ethernet, incl. USB dongles) ────────────────────────
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_RTL8152=y
